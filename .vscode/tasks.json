{
  "$schema": "https://json.schemastore.org/task.json",
  "version": "2.0.0",
  "tasks": [
    {
      "label": "eShop: Restore",
      "type": "shell",
      "command": "${workspaceFolder}/scripts/eshop.sh",
      "args": [
        "restore"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "eShop: Build",
      "type": "shell",
      "command": "${workspaceFolder}/scripts/eshop.sh",
      "args": [
        "build"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": "$msCompile",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "eShop: Test",
      "type": "shell",
      "command": "${workspaceFolder}/scripts/eshop.sh",
      "args": [
        "test"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "test",
      "problemMatcher": "$msCompile",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "eShop: Test Coverage",
      "type": "shell",
      "command": "${workspaceFolder}/scripts/eshop.sh",
      "args": [
        "test",
        "coverage"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "eShop: Format",
      "type": "shell",
      "command": "${workspaceFolder}/scripts/eshop.sh",
      "args": [
        "format"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "eShop: Clean",
      "type": "shell",
      "command": "${workspaceFolder}/scripts/eshop.sh",
      "args": [
        "clean"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "eShop: Run Aspire",
      "type": "shell",
      "command": "${workspaceFolder}/scripts/eshop.sh",
      "args": [
        "run"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true,
        "focus": false
      }
    }
  ]
}
