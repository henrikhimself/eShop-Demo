<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="Aspire.Azure.Messaging.ServiceBus" Version="13.5.3" />
    <PackageVersion Include="Aspire.Azure.Storage.Blobs" Version="13.5.3" />
    <PackageVersion Include="Aspire.Hosting.Azure.AppContainers" Version="13.5.3" />
    <PackageVersion Include="Aspire.Hosting.Azure.Redis" Version="13.5.3" />
    <PackageVersion Include="Aspire.Hosting.Azure.ServiceBus" Version="13.5.3" />
    <PackageVersion Include="Aspire.Hosting.Azure.Sql" Version="13.5.3" />
    <PackageVersion Include="Aspire.Hosting.Azure.Storage" Version="13.5.3" />
    <PackageVersion Include="Aspire.Hosting.JavaScript" Version="13.5.3" />
    <PackageVersion Include="Aspire.Hosting.Keycloak" Version="13.5.3-preview.1.26425.3" />
    <PackageVersion Include="Aspire.Hosting.SqlServer" Version="13.5.3" />
    <PackageVersion Include="Aspire.Hosting.Testing" Version="13.5.3" />
    <PackageVersion Include="Aspire.Microsoft.EntityFrameworkCore.SqlServer" Version="13.5.3" />
    <PackageVersion Include="Aspire.StackExchange.Redis" Version="13.5.3" />
    <PackageVersion Include="Aspire.StackExchange.Redis.DistributedCaching" Version="13.5.3" />
    <PackageVersion Include="Azure.Messaging.ServiceBus" Version="7.20.2" />
    <PackageVersion Include="Azure.Storage.Blobs" Version="12.28.0" />
    <PackageVersion Include="EPiServer.Azure" Version="13.1.3" />
    <PackageVersion Include="EPiServer.CMS" Version="13.1.3" />
    <PackageVersion Include="EPiServer.CMS.Core" Version="13.1.3" />
    <PackageVersion Include="EPiServer.Cms.UI.VisitorGroups" Version="13.1.3" />
    <PackageVersion Include="EPiServer.Commerce" Version="15.2.0" />
    <PackageVersion Include="EPiServer.Commerce.Core" Version="15.2.0" />
    <PackageVersion Include="EPiServer.Events.ChangeNotification" Version="13.1.3" />
    <PackageVersion Include="EPiServer.Forms" Version="6.0.1" />
    <PackageVersion Include="EPiServer.ImageLibrary.ImageSharp" Version="13.1.3" />
    <PackageVersion Include="EPiServer.Labs.LanguageManager" Version="6.0.0" />
    <PackageVersion Include="EPiServer.OptimizelyIdentity" Version="13.1.3" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="10.0.12" />
    <PackageVersion Include="Microsoft.AspNetCore.DataProtection.StackExchangeRedis" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Caching.StackExchangeRedis" Version="10.0.11" />
    <PackageVersion Include="StackExchange.Redis" Version="2.13.1" />
    <!-- Matches the version Microsoft.AspNetCore.Authentication.OpenIdConnect resolves
         transitively elsewhere in the repo (see project.assets.json), kept explicit here
         since EShop.TicketStore uses its JwtSecurityToken/-Handler types directly. -->
    <PackageVersion Include="System.IdentityModel.Tokens.Jwt" Version="8.19.2" />
    <PackageVersion Include="Optimizely.Graph.Cms" Version="13.1.3" />
    <PackageVersion Include="Optimizely.Graph.Commerce" Version="15.2.0" />
    <PackageVersion Include="System.Security.Cryptography.Xml" Version="10.0.12" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.12" />
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12" />
    <PackageVersion Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.12" />
    <!-- Direct pin, overriding Microsoft.AspNetCore.OpenApi's transitive reference.
         ASP.NET Core 10.0.12 requires Microsoft.OpenApi 2.12.0 or later but below 3.0;
         2.12.2 is the newest ADR 0013-compliant release in that supported major line. -->
    <PackageVersion Include="Microsoft.OpenApi" Version="2.12.2" />
    <PackageVersion Include="Microsoft.CodeAnalysis.Common" Version="5.3.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.3.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="5.3.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.Workspaces.Common" Version="5.3.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.Workspaces.MSBuild" Version="5.3.0" />
    <!-- Aspire.Microsoft.EntityFrameworkCore.SqlServer 13.5.3 requires EF Core
         10.0.11. These direct pins align the EF Core design-time, migration-runner,
         and integration versions with that requirement. -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.11" />
    <!-- EShop.SellerPortal.MigrationRunner uses EF Core directly for raw ADO.NET
         migration work. Keep its central pin aligned with the BFF's Aspire-provided
         EF Core runtime version. -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.11" />
    <!-- Direct pin keeps the migration runner and its BFF project reference on the
         same Microsoft.EntityFrameworkCore.Relational version, avoiding MSB3277. -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Data.SqlClient" Version="7.0.1" />
    <PackageVersion Include="Microsoft.Extensions.ApiDescription.Server" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.12" />
    <!-- 2.1.12, not the "compliant" 2.1.11: 2.1.11 has a disclosed high-severity
         vulnerability (GHSA-2m69-gcr7-jv3q) NuGet's own audit catches at restore
         time. ADR 0013's exception for a security fix applies - 2.1.12 is kept
         despite not clearing the 7-day quarantine. -->
    <PackageVersion Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.12" />
    <PackageVersion Include="Microsoft.Extensions.Caching.Hybrid" Version="10.9.0" />
    <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="10.9.0" />
    <PackageVersion Include="Microsoft.Extensions.Resilience" Version="10.9.0" />
    <PackageVersion Include="Microsoft.Extensions.ServiceDiscovery" Version="10.9.0" />
    <PackageVersion Include="Microsoft.Playwright" Version="1.62.0" />
    <!-- 2.2.3, not the newer 2.3.3: 2.3.3 does not clear ADR 0013's 7-day
         quarantine as of when this was pinned, and neither does 2.3.0, the oldest
         2.3.x release; 2.2.3 does. Covers both of these packages. -->
    <PackageVersion Include="Microsoft.Testing.Extensions.HangDump" Version="2.2.3" />
    <PackageVersion Include="Microsoft.Testing.Extensions.TrxReport" Version="2.2.3" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.18.0" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.18.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.18.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.18.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="1.18.0" />
    <PackageVersion Include="SonarAnalyzer.CSharp" Version="10.28.0.143324" />
    <PackageVersion Include="Spectre.Console" Version="0.57.2" />
    <PackageVersion Include="Spectre.Console.Cli" Version="0.55.0" />
    <PackageVersion Include="xunit.v3.assert" Version="3.2.2" />
    <PackageVersion Include="xunit.v3.mtp-v2" Version="3.2.2" />
    <PackageVersion Include="Scrutor" Version="7.0.0" />
  </ItemGroup>
</Project>
