    <PackageVersion Include="Epicweb.Optimizely.AIAssistant" Version="4.2.4" />
    <PackageVersion Include="Epicweb.Optimizely.AIAssistant.Tools" Version="4.0.1" />
    <PackageVersion Include="EPiServer.Azure" Version="13.3.0" />
    <PackageVersion Include="EPiServer.CMS" Version="13.3.0" />
    <PackageVersion Include="EPiServer.CMS.Core" Version="13.3.0" />
    <PackageVersion Include="EPiServer.Cms.UI.VisitorGroups" Version="13.3.0" />
    <PackageVersion Include="EPiServer.Commerce" Version="15.2.0" />
    <PackageVersion Include="EPiServer.Commerce.Core" Version="15.2.0" />
    <PackageVersion Include="EPiServer.Events.ChangeNotification" Version="13.3.0" />
