<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="Aspire.Azure.Messaging.ServiceBus" Version="13.6.0" />
    <PackageVersion Include="Aspire.Azure.Storage.Blobs" Version="13.6.0" />
    <PackageVersion Include="Aspire.Hosting.Azure.AppContainers" Version="13.6.0" />
    <PackageVersion Include="Aspire.Hosting.Azure.Redis" Version="13.6.0" />
