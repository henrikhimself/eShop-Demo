    <PackageVersion Include="Aspire.Hosting.Azure.Storage" Version="13.6.0" />
    <PackageVersion Include="Aspire.Hosting.JavaScript" Version="13.6.0" />
    <PackageVersion Include="Aspire.Hosting.Keycloak" Version="13.6.0-preview.1.26479.8" />
    <PackageVersion Include="Aspire.Hosting.SqlServer" Version="13.6.0" />
    <PackageVersion Include="Aspire.Hosting.Testing" Version="13.6.0" />
    <PackageVersion Include="Aspire.Microsoft.EntityFrameworkCore.SqlServer" Version="13.6.0" />
    <PackageVersion Include="Aspire.StackExchange.Redis" Version="13.6.0" />
    <PackageVersion Include="Aspire.StackExchange.Redis.DistributedCaching" Version="13.6.0" />
