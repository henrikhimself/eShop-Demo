<Project>

  <!-- Shared by EShop.StoreFront.MigrationRunner.csproj and
       EShop.StoreFront.MigrationRunner.Tests.csproj (see
       doc/adr/0023-explicit-database-schema-migration-resources.md and doc/CHRONICLE.md) -
       copies the real Optimizely SQL scripts (episerver.cms.core/episerver.commerce.core
       NuGet packages' own tools/ folder) into the importing project's build output, so it
       ships/tests against them without needing the NuGet cache present at runtime. Merges
       two source packages into each destination folder: episerver.commerce.core's
       tools/epiupdates_CMS/sql ships CMS-targeting scripts despite living inside the
       Commerce package (confirmed by decompiling EPiServer.Net.Cli's UpdateDatabase - see
       doc/CHRONICLE.md), so it's merged into the "Cms" destination alongside
       episerver.cms.core's own tools/epiupdates/sql, not into "Commerce".

       The importing project must set $(OptimizelySchemaScriptsDestinationName) before
       importing this file - no default, each importer picks its own name deliberately.
       EShop.StoreFront.MigrationRunner.Tests uses "RealOptimizelySchemaScripts" instead of
       "OptimizelySchemaScripts" to keep the real shipped scripts distinguishable from its
       own synthetic fixture scripts - see RealOptimizelyScriptsTests.cs. -->
  <Target Name="CopyOptimizelySchemaScripts" AfterTargets="Build">
    <Error Condition="'$(OptimizelySchemaScriptsDestinationName)' == ''"
           Text="Set $(OptimizelySchemaScriptsDestinationName) before importing CopyOptimizelySchemaScripts.targets." />

    <!-- @(PackageReference) items don't carry %(Version) metadata under central package
         management by the time this target runs - read the version from
         @(PackageVersion) instead, the item group Directory.Packages.props itself
         populates, always available regardless of package resolution. -->
    <ItemGroup>
      <_CmsCoreReference Include="@(PackageVersion)" Condition="'%(Identity)' == 'EPiServer.CMS.Core'" />
      <_CommerceCoreReference Include="@(PackageVersion)" Condition="'%(Identity)' == 'EPiServer.Commerce.Core'" />
    </ItemGroup>

    <PropertyGroup>
      <_NuGetPackageRoot>$([MSBuild]::EnsureTrailingSlash('$(NuGetPackageRoot)'))</_NuGetPackageRoot>
      <_CmsCoreToolsDir>$(_NuGetPackageRoot)episerver.cms.core\@(_CmsCoreReference->'%(Version)')\tools\</_CmsCoreToolsDir>
      <_CommerceCoreToolsDir>$(_NuGetPackageRoot)episerver.commerce.core\@(_CommerceCoreReference->'%(Version)')\tools\</_CommerceCoreToolsDir>
      <_CmsDestDir>$(OutDir)$(OptimizelySchemaScriptsDestinationName)\Cms\</_CmsDestDir>
      <_CommerceDestDir>$(OutDir)$(OptimizelySchemaScriptsDestinationName)\Commerce\</_CommerceDestDir>
    </PropertyGroup>

    <!-- Every item carries its own destination subfolder explicitly - none of these globs
         are recursive (**), so MSBuild's %(RecursiveDir) metadata (which only populates
         for a recursive glob) can't be relied on to preserve the epiupdates/sql
         nesting. -->
    <ItemGroup>
      <_CmsScripts Include="$(_CmsCoreToolsDir)EPiServer.Cms.Core.sql">
        <DestinationSubdir></DestinationSubdir>
      </_CmsScripts>
      <_CmsScripts Include="$(_CmsCoreToolsDir)epiupdates\sql\*.sql">
        <DestinationSubdir>epiupdates\sql\</DestinationSubdir>
      </_CmsScripts>
      <_CmsScripts Include="$(_CommerceCoreToolsDir)epiupdates_CMS\sql\*.sql">
        <DestinationSubdir>epiupdates_CMS\sql\</DestinationSubdir>
      </_CmsScripts>
      <_CommerceScripts Include="$(_CommerceCoreToolsDir)EPiServer.Commerce.Core.sql">
        <DestinationSubdir></DestinationSubdir>
      </_CommerceScripts>
      <_CommerceScripts Include="$(_CommerceCoreToolsDir)epiupdates_commerce\sql\*.sql">
        <DestinationSubdir>epiupdates_commerce\sql\</DestinationSubdir>
      </_CommerceScripts>
    </ItemGroup>

    <Copy
      SourceFiles="@(_CmsScripts)"
      DestinationFolder="$(_CmsDestDir)%(DestinationSubdir)"
      SkipUnchangedFiles="true" />
    <Copy
      SourceFiles="@(_CommerceScripts)"
      DestinationFolder="$(_CommerceDestDir)%(DestinationSubdir)"
      SkipUnchangedFiles="true" />
  </Target>

</Project>
