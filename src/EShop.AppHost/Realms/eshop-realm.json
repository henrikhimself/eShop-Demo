  "clients": [
    {
      "clientId": "seller-portal",
      "name": "Seller Portal BFF",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "seller-secret",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "https://seller.eshop.local:8443/bff/signin-oidc"
      ],
      "webOrigins": [
        "https://seller.eshop.local:8443"
      ],
      "protocolMappers": [
        {
          "name": "seller-role-mapper",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "user.attribute": "foo",
            "claim.name": "role",
            "jsonType.label": "String",
            "multivalued": "true",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ],
      "attributes": {
        "post.logout.redirect.uris": "https://seller.eshop.local:8443/bff/signout-callback-oidc"
      }
    },
    {
      "clientId": "storefront",
      "name": "Storefront",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "storefront-secret",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "https://storefront.eshop.local:8443/signin-oidc"
      ],
      "webOrigins": [
        "https://storefront.eshop.local:8443"
      ],
      "protocolMappers": [
        {
          "name": "storefront-role-mapper",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "user.attribute": "foo",
            "claim.name": "role",
            "jsonType.label": "String",
            "multivalued": "true",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ],
      "attributes": {
        "post.logout.redirect.uris": "https://storefront.eshop.local:8443/signout-callback-oidc"
      }
    }
  ]
}
