<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- See EShop.StoreFront.MigrationRunner.csproj - the whole EPiServer.CMS/Commerce
         13.0.2/15.1.0 dependency graph declares an upper bound of
         Microsoft.Data.SqlClient < 7.0.0, predating this repo's 7.0.1 pin (ADR 0013). -->
    <NoWarn>NU1608</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- The "meta" packages (EPiServer.CMS/EPiServer.Commerce), not the individual
         .Core/.AspNetCore sub-packages - see Directory.Packages.props. Restored from
         Optimizely's own NuGet feed (nuget.config's package source mapping). -->
    <PackageReference Include="EPiServer.CMS" />
    <PackageReference Include="EPiServer.Commerce" />
    <!-- Extra assemblies AddCommerce() needs at runtime that neither meta-package pulls
         in transitively - see Directory.Packages.props for how this was found. -->
    <PackageReference Include="EPiServer.Events.ChangeNotification" />
    <PackageReference Include="EPiServer.OptimizelyIdentity" />
    <!-- For StorefrontMigrationPreflight's own marker-table check, ahead of anything
         EPiServer.CMS/Commerce itself opens. -->
    <PackageReference Include="Microsoft.Data.SqlClient" />
    <!-- Dual-provider OIDC (Keycloak locally / Microsoft Entra External ID once
         deployed - ADR 0002/0010/0020), mirroring EShop.SellerPortal.Bff's own wiring. -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../EShop.Common/EShop.Common.csproj" />
    <ProjectReference Include="../EShop.Migrations.Common/EShop.Migrations.Common.csproj" />
    <ProjectReference Include="../EShop.Migrations.Orchestration/EShop.Migrations.Orchestration.csproj" />
    <ProjectReference Include="../EShop.Migrations.Optimizely/EShop.Migrations.Optimizely.csproj" />
    <ProjectReference Include="../EShop.ServiceDefaults/EShop.ServiceDefaults.csproj" />
  </ItemGroup>

</Project>
