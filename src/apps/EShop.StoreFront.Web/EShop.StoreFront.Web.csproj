<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RequiresAspNetWebAssets>true</RequiresAspNetWebAssets>
    <!-- EPiServer.CMS/Commerce 13.1.3/15.2.0 dependency graph declares an upper bound of Microsoft.Data.SqlClient < 7.0.0 -->
    <NoWarn>NU1608</NoWarn>
  </PropertyGroup>

  <!-- The Optimizely CMS 13.1.3 dependency graph requires ImageSharp [3.1.12, 4.0.0).
       The five advisory suppressions are an accepted, temporary risk tracked in doc/RISKS.md.
       Keep this list specific so NuGet Audit continues to fail for every other advisory. -->
  <ItemGroup>
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-gwg2-r3hj-4w44" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-j3p4-wp97-rph4" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-j9gm-c75j-xc9q" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-jjfr-hcj7-qf5w" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-wmxv-xphr-5c9g" />
  </ItemGroup>

  <ItemGroup>
		<PackageReference Include="EPiServer.Cms.UI.ContentManager" />
		<PackageReference Include="Microsoft.AspNetCore.Mvc.Razor.RuntimeCompilation" />
		<PackageReference Include="Optimizely.Cms.Opal.Tools" />
		<PackageReference Include="Scrutor" />
    <PackageReference Include="EPiServer.Azure" />
    <PackageReference Include="EPiServer.Cms.UI.VisitorGroups" />
    <PackageReference Include="EPiServer.CMS" />
    <PackageReference Include="EPiServer.Commerce" />
    <PackageReference Include="EPiServer.Events.ChangeNotification" />
    <PackageReference Include="EPiServer.Forms" />
    <PackageReference Include="EPiServer.ImageLibrary.ImageSharp" />
    <PackageReference Include="EPiServer.Labs.LanguageManager" />
    <PackageReference Include="EPiServer.OptimizelyIdentity" />
    <PackageReference Include="Optimizely.Graph.Cms" />
    <PackageReference Include="Optimizely.Graph.Commerce" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" />
    <PackageReference Include="Microsoft.AspNetCore.DataProtection.StackExchangeRedis" />
    <PackageReference Include="Microsoft.Data.SqlClient" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" />
    <PackageReference Include="Microsoft.Extensions.Caching.StackExchangeRedis" />
    <PackageReference Include="StackExchange.Redis" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../shared/EShop.Common/EShop.Common.csproj" />
    <ProjectReference Include="../../shared/EShop.TicketStore/EShop.TicketStore.csproj" />
    <ProjectReference Include="../../migrations/EShop.Migrations.Common/EShop.Migrations.Common.csproj" />
    <ProjectReference Include="../../migrations/EShop.Migrations.Orchestration/EShop.Migrations.Orchestration.csproj" />
    <ProjectReference Include="../../migrations/EShop.Migrations.Optimizely/EShop.Migrations.Optimizely.csproj" />
    <ProjectReference Include="../../EShop.ServiceDefaults/EShop.ServiceDefaults.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="EShop.StoreFront.Web.Tests" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="wwwroot\" />
  </ItemGroup>

</Project>
