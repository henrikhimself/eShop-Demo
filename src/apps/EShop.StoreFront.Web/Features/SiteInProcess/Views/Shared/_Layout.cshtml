@using EPiServer.SpecializedProperties
@using EPiServer.Web.Mvc.Html
@using Hj.EShop.StoreFront.Web.Foundation.ContentModel.Cms.Blocks.SiteSettings
@using Hj.EShop.StoreFront.Web.Foundation.Operations
@using Hj.EShop.StoreFront.Web.Foundation.SiteSettings
@{
    ISiteSettingsService? siteSettingsService = Context.RequestServices.GetRequiredService<ISiteSettingsService>();

    OperationRequest? request = Context.CreateOperationRequest();

    LayoutSettingsBlock layoutModel = await siteSettingsService.GetAsync<LayoutSettingsBlock>(request);
    ServiceMenuSettingsBlock serviceMenuModel = await siteSettingsService.GetAsync<ServiceMenuSettingsBlock>(request);
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@ViewBag.Title</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-1BmE4kWBq78iYhFldvKuhfTAU6auU8tT94WrHftjDbrCEXSU1oBoqyl2QvZ6jIW3" crossorigin="anonymous">
</head>
<body>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-ka7Sk0Gln4gmtz2MlQnikT1wXgYsOg+OMhuP+IlRH9sENBO0LRn5q+8nbTov4+1p" crossorigin="anonymous"></script>
    <main>
		<div class="container">
			<header class="d-flex flex-wrap justify-content-center py-3 mb-4 border-bottom">
				<a href="/" class="d-flex align-items-center mb-3 mb-md-0 me-md-auto text-dark text-decoration-none">
					<img src="@Url.ContentUrl(layoutModel.Logo)" width="100">
				</a>
				<ul class="nav nav-pills">
					@if (serviceMenuModel.NavigationLinks != null)
					{
						@foreach (LinkItem navigationItem in serviceMenuModel.NavigationLinks)
						{
							<li class="nav-item"><a href="@Url.ContentUrl(navigationItem.Href)" class="nav-link" target="@navigationItem.Target" alt="@navigationItem.Title">@navigationItem.Text</a></li>
						}
					}
				</ul>
			</header>
		</div>
	    @RenderBody()
	</main>
</body>
</html>
