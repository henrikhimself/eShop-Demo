@model ProductListViewModel

<section class="container py-5 text-center">
	<div class="row">
		<div class="col-6 mx-auto">
			<h1 class="fw-light"><span epi-property="CurrentContent.Name"/></h1>
		</div>
	</div>
</section>

<div class="album py-5 bg-light">
	<div class="container">
		<div class="row row-cols-2 row-cols-md-3 row-cols-lg-4 row-cols-xl-5 row-cols-xxl-6 g-3">
			@foreach (var movie in Model.Movies)
			{
				<div class="col">
					<div class="card shadow-sm h-100">
						<a role="button" aria-disabled="true" href="@Url.ContentUrl(movie.ContentLink)">
							<img src="@Url.ContentUrl(movie.PosterImage)" class="bd-placeholder-img card-img-top" height="300" loading="lazy">
						</a>
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-center">
                                <div class="btn-group">
                                    <a class="btn btn-sm btn-outline-secondary" role="button" aria-disabled="true" href="@Url.ContentUrl(movie.ContentLink)">View</a>
                                </div>
                            </div>
                            <p class="card-text mt-3">@movie.Description</p>
                        </div>
					</div>
				</div>
			}
		</div>
	</div>
</div>
