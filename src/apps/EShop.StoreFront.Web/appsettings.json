{
  "SiteInitialization": {
    "ApplicationName": "StoreFront"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Optimizely": {
    "ContentGraph": {
      "GatewayAddress": "https://cg.optimizely.com",
      "AppKey": "(secret)",
      "Secret": "(secret)",
      "SingleKey": "(secret)",
      "AllowSendingLog": "false"
    }
  },
  "EPiServer": {
    "Commerce": {
      "SkipCatalogContentModelCheck": false,
      "ArchivedThreshold": 1
    },
    "Cms": {
      "Scheduler": {
        "Enabled": false
      },
      "MappedRoles": {
        "Items": {
          "Administrators": {
            "MappedRoles": [
              "SiteAdministrator"
            ]
          },
          "CmsAdmins": {
            "MappedRoles": [
              "SiteAdministrator"
            ]
          },
          "CommerceAdmins": {
            "MappedRoles": [
              "SiteAdministrator"
            ]
          },
          "CmsEditors": {
            "MappedRoles": [
              "ContentEditor"
            ]
          },
          "VisitorGroupAdmins": {
            "MappedRoles": [
              "ContentEditor"
            ]
          },
          "contentapiread": {
            "MappedRoles": [
              "CmsAdmins",
              "CmsEditors"
            ]
          }
        }
      }
    },
    "CmsUI": {
      "HeadlessMode" : {
         "HeadlessModeEnabled" : false
      },
      "ProjectUIOptions": {
        "ProjectModeEnabled": true
      },
      "CmsFeatureOptions": {
        "SectionsVisibility": {
          "OnPageEditing": true,
          "GlobalFallbackLanguages": true
        }
      }
    }
  }
}
