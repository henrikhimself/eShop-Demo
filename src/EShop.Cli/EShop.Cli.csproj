<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Published self-contained per-RID by scripts/eshop.sh via the utility
         container - see doc/adr/0016-eshop-cli-replaces-bash-scripts.md. Neither
         Native AOT nor trimming is part of this design (explicit, not
         default-implied). -->
    <PublishTrimmed>false</PublishTrimmed>
    <!-- Drops non-English satellite resource DLLs (localized exception messages, etc.)
         from the publish output. Safe independently of trimming: nothing here is
         localized or reads a non-English resource. -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- Needed only for LinuxIdentityProvider's getuid/getgid LibraryImport marshalling. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Spectre.Console" />
    <PackageReference Include="Spectre.Console.Cli" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../EShop.Common/EShop.Common.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="EShop.Cli.Tests" />
  </ItemGroup>

</Project>
