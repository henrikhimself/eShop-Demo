<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!-- Mirrors the Storefront application's accepted ImageSharp advisory risk in
       doc/RISKS.md so this project's restore audits the same dependency graph. -->
  <ItemGroup>
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-gwg2-r3hj-4w44" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-j3p4-wp97-rph4" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-j9gm-c75j-xc9q" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-jjfr-hcj7-qf5w" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-wmxv-xphr-5c9g" />
  </ItemGroup>

  <ItemGroup>
    <!-- Direct reference needed so the Directory.Packages.props security-fix pin to
         System.Security.Cryptography.Xml 10.0.10 applies here too; the referenced
         StoreFront.Web/Optimizely dependency graph otherwise restores 10.0.6 and the
         repo's audit-as-error gate fails. -->
    <PackageReference Include="System.Security.Cryptography.Xml" />
    <PackageReference Include="xunit.v3.mtp-v2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/apps/EShop.StoreFront.Web/EShop.StoreFront.Web.csproj" />
  </ItemGroup>

</Project>
