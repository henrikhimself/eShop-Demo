<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <!-- See EShop.StoreFront.MigrationRunner.csproj - same transitive
         EPiServer.CMS.Core/EPiServer.Commerce.Core upper-bound conflict via the project
         reference below. -->
    <NoWarn>NU1608</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" />
    <PackageReference Include="xunit.v3.mtp-v2" />
    <!-- See EShop.StoreFront.MigrationRunner.csproj - direct reference needed for the
         Directory.Packages.props security-fix pin to actually apply. -->
    <PackageReference Include="System.Security.Cryptography.Xml" />
    <!-- Referenced so RealOptimizelyScriptsTests can run the actual shipped scripts
         (not just the synthetic fixture ones), giving a version bump a real test to
         fail against - only needs the tools/ folder, mirroring
         EShop.StoreFront.MigrationRunner.csproj's own reference/copy step. Not shared
         with that project's build output on purpose - test projects don't reference
         each other's output in this repo. -->
    <PackageReference Include="EPiServer.CMS.Core" />
    <PackageReference Include="EPiServer.Commerce.Core" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/migrations/EShop.Migrations.Orchestration/EShop.Migrations.Orchestration.csproj" />
    <ProjectReference Include="../../src/migrations/EShop.Migrations.Optimizely/EShop.Migrations.Optimizely.csproj" />
    <ProjectReference Include="../../src/apps/EShop.StoreFront.MigrationRunner/EShop.StoreFront.MigrationRunner.csproj" />
    <ProjectReference Include="../EShop.Testing.Common/EShop.Testing.Common.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <!-- Kept distinct from EShop.StoreFront.MigrationRunner.csproj's
         "OptimizelySchemaScripts" so the real shipped scripts stay distinguishable from
         this project's own synthetic fixture scripts - see RealOptimizelyScriptsTests.cs. -->
    <OptimizelySchemaScriptsDestinationName>RealOptimizelySchemaScripts</OptimizelySchemaScriptsDestinationName>
  </PropertyGroup>

  <!-- See CopyOptimizelySchemaScripts.targets, shared with
       EShop.StoreFront.MigrationRunner.csproj. -->
  <Import Project="../../src/migrations/EShop.Migrations.Optimizely/CopyOptimizelySchemaScripts.targets" />

</Project>
